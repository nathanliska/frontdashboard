# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=frontdash
POSTGRES_PASSWORD=frontdash
POSTGRES_DB=frontdashboard

# Connection URL used by the backend (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://frontdash:frontdash@db:5432/frontdashboard

# ─── Redis ────────────────────────────────────────────────────────────────────
# Rate-limit windows. `redis` is the compose service, so running the backend outside Docker wants
# localhost instead — unreachable, it falls back to per-process limits and only logs a warning.
REDIS_URL=redis://redis:6379/0

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Also widens the Origin allowlist that guards every
# state-changing request, so reaching the dev server over the LAN (testing on a phone — Vite binds
# all interfaces) needs that address here too, e.g. http://192.168.1.50:5173. Without it those
# mutations answer 403 "Cross-origin request rejected", and the backend logs the origin it saw.
CORS_ORIGINS=http://localhost:5173

# ─── App ──────────────────────────────────────────────────────────────────────
# Valid values: development, production, test
ENVIRONMENT=development
LOG_LEVEL=debug
FRONTEND_BASE_URL=http://localhost:5173

# ─── Email Verification ───────────────────────────────────────────────────────
# Leave RESEND_API_KEY unset in local development: with ENVIRONMENT=development, outgoing
# mail is written to backend/.dev-mail/ instead of being sent. Open the newest .txt there for
# the verification or reset link. The links are live credentials, so they stay out of the log.
RESEND_API_KEY=
# If you set RESEND_API_KEY locally before verifying your own domain, Resend's
# onboarding sender may work for sending to your account email.
EMAIL_FROM="FrontDashboard <onboarding@resend.dev>"
