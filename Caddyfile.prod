:80 {
	# SSE: disable buffering so events are streamed immediately
	handle /api/sse {
		reverse_proxy frontdashboard-backend:8000 {
			flush_interval -1
		}
	}

	# API routes
	handle /api/* {
		reverse_proxy frontdashboard-backend:8000
	}

	# Static files with SPA fallback
	handle {
		root * /srv
		try_files {path} /index.html
		header {
			Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'"
			X-Permitted-Cross-Domain-Policies none
		}
		file_server
	}

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}
}
