:80 {
	# SSE: disable buffering so events are streamed immediately
	handle /api/sse {
		reverse_proxy frontdashboard-backend:8000 {
			flush_interval -1
		}
	}

	# API routes
	handle /api/* {
		# Rejected at the proxy rather than after FastAPI has read and parsed it. Field-level
		# max_length validators bound individual strings, but nothing bounded a whole body, so a
		# single request was limited only by what the origin would accept. 1MB is far above any
		# real payload here — the largest is a dashboard layout PUT, a few KB — and is not a
		# limit any legitimate client can reach. Excluded from the /api/sse handler above, which
		# is a long-lived response rather than a request body.
		request_body {
			max_size 1MB
		}
		reverse_proxy frontdashboard-backend:8000
	}

	# Static files with SPA fallback
	handle {
		root * /srv
		try_files {path} /index.html
		header {
			Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'"
			X-Permitted-Cross-Domain-Policies none
		}
		file_server
	}

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}
}
