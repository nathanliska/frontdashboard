# ─── Database (external Postgres 17 on Unraid) ───────────────────────────────
DATABASE_URL=postgresql+asyncpg://frontdashboard:<password>@<unraid-ip>:5432/frontdashboard

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=info
FRONTEND_BASE_URL=https://dash.grizzlypmaa.com

# ─── Email Verification ───────────────────────────────────────────────────────
RESEND_API_KEY=
# Verify dash.grizzlypmaa.com in Resend, add the SPF/DKIM records in Cloudflare.
EMAIL_FROM="FrontDashboard <noreply@dash.grizzlypmaa.com>"
