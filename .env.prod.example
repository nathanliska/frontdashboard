# ─── Database (external Postgres 17 on the prod host) ────────────────────────
DATABASE_URL=postgresql+asyncpg://frontdashboard:<password>@<db-host-ip>:5432/frontdashboard

# ─── App ──────────────────────────────────────────────────────────────────────
# Valid values: development, production, test
ENVIRONMENT=production
LOG_LEVEL=info
FRONTEND_BASE_URL=https://dash.example.com
# Origins allowed to make state-changing requests. `require_csrf` 403s any other `Origin`, so set
# this even when it duplicates FRONTEND_BASE_URL.
CORS_ORIGINS=https://dash.example.com

# ─── Redis ────────────────────────────────────────────────────────────────────
# Bundled in the stack, on the internal network with no published port, so this needs no value.
# Set it only to point at an external instance — production refuses to start on an empty one,
# because slowapi reads an empty uri as `memory://` and would run on per-process limits in silence.
# REDIS_URL=redis://redis:6379/0

# ─── Email Verification ───────────────────────────────────────────────────────
# REQUIRED in production: email verification is mandatory, so RESEND_API_KEY
# must be set, and EMAIL_FROM must use a deliverable domain (not
# @frontdashboard.local) — startup fails fast otherwise.
RESEND_API_KEY=
# Verify the EMAIL_FROM domain in Resend, add the SPF/DKIM records in Cloudflare.
EMAIL_FROM="FrontDashboard <noreply@example.com>"
