# ─── Database (external Postgres 17 on Unraid) ───────────────────────────────
DATABASE_URL=postgresql+asyncpg://frontdashboard:<password>@<unraid-ip>:5432/frontdashboard

# ─── App ──────────────────────────────────────────────────────────────────────
# Valid values: development, production, test
ENVIRONMENT=production
LOG_LEVEL=info
FRONTEND_BASE_URL=https://dash.zalis.app
# Origins allowed to make state-changing requests. `require_csrf` 403s any other `Origin`, so set
# this even when it duplicates FRONTEND_BASE_URL.
CORS_ORIGINS=https://dash.zalis.app

# ─── Email Verification ───────────────────────────────────────────────────────
# REQUIRED in production: email verification is mandatory, so RESEND_API_KEY
# must be set, and EMAIL_FROM must use a deliverable domain (not
# @frontdashboard.local) — startup fails fast otherwise.
RESEND_API_KEY=
# Verify the EMAIL_FROM domain in Resend, add the SPF/DKIM records in Cloudflare.
EMAIL_FROM="FrontDashboard <noreply@zalis.app>"
