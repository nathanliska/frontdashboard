# Build stage: uv resolves and installs into /app/.venv, then is thrown away. Nothing here
# reaches the runtime image — not the 54 MB uv binary, not its wheel cache, not the lockfile.
FROM python:3.12-slim AS build

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/

COPY pyproject.toml uv.lock* ./
RUN uv sync --frozen --no-dev --no-cache

# Runtime stage: same base as the builder, so the venv's interpreter symlink and the compiled
# wheels' ABI still match. The venv is copied to the same absolute path it was created at
# (/app/.venv) — console scripts embed that path in their shebangs and would break if moved.
FROM python:3.12-slim

WORKDIR /app

COPY --from=build /app/.venv .venv
COPY app/ app/
COPY alembic/ alembic/
COPY alembic.ini .
ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

HEALTHCHECK --interval=60s --timeout=5s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health')"]

CMD alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --log-level ${LOG_LEVEL:-info}
