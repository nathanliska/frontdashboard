# Pinned by digest so rebuilding an old commit produces the same image, and refreshed by hand:
# Dependabot bumps the tag but has never sent a digest-only update, which pinning alone needs.
FROM python:3.14-slim@sha256:a7fb1e634c4a578f9e0bd6327f11a3cde11b7a9395f48e24360c0988bcc5c2bc AS build

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest@sha256:069a51314a7bb6031777a9273205fe1b0b19e914ef418207d1338b268df641dd /uv /bin/

COPY pyproject.toml uv.lock* ./
RUN uv sync --frozen --no-dev --no-cache

# Same base as the builder, so the venv's interpreter symlink and wheel ABIs still match. It must
# land at the path it was built at — console scripts embed that in their shebangs.
FROM python:3.14-slim@sha256:a7fb1e634c4a578f9e0bd6327f11a3cde11b7a9395f48e24360c0988bcc5c2bc

WORKDIR /app

COPY --from=build /app/.venv .venv
COPY app/ app/
COPY alembic/ alembic/
COPY alembic.ini .
ENV PATH="/app/.venv/bin:$PATH"

# Unprivileged: the process writes nothing to disk, so root only makes a container escape worse.
# Files stay root-owned, so the app can read its code and cannot modify it.
RUN useradd --system --uid 10001 --no-create-home appuser
USER appuser

EXPOSE 8000

# Readiness, not liveness: it drives `depends_on: service_healthy`, so a database outage should
# read as unhealthy. Safe to gate on a dependency because Docker reports it without restarting.
HEALTHCHECK --interval=60s --timeout=5s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health/ready')"]

# Migrations stay here: alembic/env.py holds a session-scoped advisory lock, so replicas starting
# together serialize instead of racing. The named shell is for `&&` and the `${VAR:-default}`
# expansions; `exec` leaves uvicorn as PID 1 so a stop reaches it.
# No `--workers`: forked workers share one socket, so a scrape reaches whichever accepts it and
# every counter reads as resetting. Scale with replicas, which Prometheus sums across targets.
CMD ["/bin/sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --log-level ${LOG_LEVEL:-info}"]
