{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "format": "biome format --write .",
    "audit:fix": "npm audit fix",
    "typecheck": "tsc --build --force",
    "test": "vitest",
    "test:run": "vitest run",
    "preview": "vite preview",
    "generate:contract": "typed-openapi ../backend/openapi.json -r zod --schemas-only --no-runtime-types --openapi-additional-properties-default -o ./src/api/generated/contract.ts && node scripts/import-zod-config.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^2.3.0",
    "react-resizable": "^3.2.0",
    "react-router": "^8.5.1",
    "zod": "4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/ui": "^5.1.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "tailwindcss": "^4.2.2",
    "typed-openapi": "4.1.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "oxfmt@0.59.0": {
      "tinypool": "2.1.2"
    }
  }
}
