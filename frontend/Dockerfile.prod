# Pinned by digest so an old commit rebuilds identically, and refreshed by hand: Dependabot bumps
# the tag but has never sent a digest-only update, without which pinning freezes security patches.
FROM node:24-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .
RUN npm run build

# Here only for the binary: `cp` drops xattrs, stripping the capability it ships with. `COPY --from`
# preserves capabilities, and stripping one above the caddy base rewrites all 48 MB of it.
FROM caddy:alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648 AS caddy
RUN cp /usr/bin/caddy /caddy

# Alpine, not the caddy image, so that binary ships once rather than twice. Caddy is static; mailcap
# (76 kB) covers the types Go's builtin table lacks — fonts, .webmanifest — as the caddy image does.
FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

ENV XDG_CONFIG_HOME=/config XDG_DATA_HOME=/data

# Caddy writes /config/caddy/autosave.json and cert storage under /data.
RUN apk add --no-cache ca-certificates mailcap \
 && mkdir -p /config/caddy /data/caddy /etc/caddy \
 && adduser -S -u 10001 caddyuser \
 && chown -R caddyuser /data /config

COPY --from=caddy /caddy /usr/bin/caddy
COPY --from=build /app/dist /srv
COPY Caddyfile.prod /etc/caddy/Caddyfile

WORKDIR /srv

# Numeric, not the name: a runtime that verifies non-root can only read a UID.
USER 10001

EXPOSE 80

HEALTHCHECK --interval=60s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ || exit 1

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
