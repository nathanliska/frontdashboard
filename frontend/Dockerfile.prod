# Pinned by digest for reproducibility; Dependabot's docker ecosystem keeps them current.
FROM node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .
RUN npm run build

# Still runs as root: Caddy binds :80 here, and moving to an unprivileged port would have to
# be coordinated with whatever fronts it. Tracked in #36.
FROM caddy:alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648


COPY --from=build /app/dist /srv
COPY Caddyfile.prod /etc/caddy/Caddyfile

HEALTHCHECK --interval=60s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ || exit 1
