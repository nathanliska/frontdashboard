# Pinned by digest for reproducibility; Dependabot's docker ecosystem keeps them current.
FROM node:24-alpine@sha256:f70403e87646dc51b45295f4b8b70cdad0b63d2297c4c9899119b03f7af7a6b3 AS build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .
RUN npm run build

FROM caddy:alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648

# Unprivileged, while still binding :80. Ports below 1024 need CAP_NET_BIND_SERVICE, not root —
# granting the binary that one capability is what lets the port stay where the tunnel already
# points. Moving to :8080 would have worked too, but it would have meant a coordinated change to
# the cloudflared ingress, with the site down if the two landed out of order.
RUN apk add --no-cache libcap \
 && setcap cap_net_bind_service=+ep /usr/bin/caddy \
 && apk del libcap \
 && adduser -S -u 10001 caddyuser \
 && chown -R caddyuser /data /config

COPY --from=build /app/dist /srv
COPY Caddyfile.prod /etc/caddy/Caddyfile

USER caddyuser

HEALTHCHECK --interval=60s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ || exit 1
