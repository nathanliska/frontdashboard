    {
      "id": 16,
      "type": "stat",
      "title": "Resident memory",
      "description": "The leak signal for a process holding streams open for half an hour. No mem_limit is set on this service, so the thresholds are headroom against an Argon2 burst rather than a configured ceiling.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 471859200
              },
              {
                "color": "red",
                "value": 734003200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "text": {
          "valueSize": 32
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(process_resident_memory_bytes{job=\"frontdashboard\"})",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 100,
      "type": "row",
      "title": "Requests & hashing",
