        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Argon2 latency & saturation",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Latency includes time queued for a limiter slot, so a p95 well above the ~34ms floor is contention. Slots in flight and queued share the right axis.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "always",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "pointSize": 5
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byNames",
              "options": {
                "mode": "include",
                "names": [
                  "queued",
                  "in flight",
                  "slot limit"
                ]
              }
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "slots"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byNames",
              "options": {
                "mode": "include",
                "names": [
                  "slot limit"
                ]
              }
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "refId": "A",
          "range": true,
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(frontdashboard_argon2_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{operation}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "refId": "B",
          "range": true,
          "expr": "histogram_quantile(0.50, sum by (le, operation) (rate(frontdashboard_argon2_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{operation}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "refId": "C",
          "range": true,
          "expr": "sum by (operation) (rate(frontdashboard_argon2_seconds_sum[$__rate_interval])) / sum by (operation) (rate(frontdashboard_argon2_seconds_count[$__rate_interval]))",
          "legendFormat": "mean {{operation}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(frontdashboard_argon2_waiting)",
          "legendFormat": "queued",
          "range": true,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(frontdashboard_argon2_in_flight)",
          "legendFormat": "in flight",
          "range": true,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(frontdashboard_argon2_limit)",
          "legendFormat": "slot limit",
          "range": true,
          "refId": "F"
        }
      ]
    },
