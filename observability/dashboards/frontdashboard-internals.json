          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "text": {
          "valueSize": 32
        }
      },
      "targets": [
        {
          "datasource": {
