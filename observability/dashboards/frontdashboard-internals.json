                "0": {
                  "text": "attached",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "detached",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
