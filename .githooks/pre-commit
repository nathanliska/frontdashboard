#!/usr/bin/env bash
# Run full backend lint and format check, then lint-staged frontend, before each commit

# Block direct commits to main
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  echo "ERROR: Direct commits to main are not allowed. Use a feature branch."
  exit 1
fi

# Backend: ruff lint + format check
if [ -f "backend/pyproject.toml" ]; then
  echo "[pre-commit] Running ruff check..."
  ( cd backend && uv run ruff check . ) || exit 1

  echo "[pre-commit] Running ruff format check..."
  ( cd backend && uv run ruff format --check . ) || {
    echo ""
    echo "  Formatting issues found. Run: make format"
    echo ""
    exit 1
  }
fi

# Frontend: lint-staged
if [ -f "frontend/package.json" ]; then
  echo "[pre-commit] Running lint-staged..."
  ( cd frontend && npx lint-staged ) || exit 1
fi

exit 0
