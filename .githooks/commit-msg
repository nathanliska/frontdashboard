#!/usr/bin/env bash
# Enforce Conventional Commits format
# https://www.conventionalcommits.org/

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Skip merge commits
if echo "$commit_msg" | grep -qE "^Merge "; then
  exit 0
fi

# Skip fixup/squash commits
if echo "$commit_msg" | grep -qE "^(fixup|squash)!"; then
  exit 0
fi

pattern="^(feat|fix|chore|docs|style|refactor|test|perf|ci|build|revert)(\(.+\))?(!)?: .{1,}"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "ERROR: Commit message does not follow Conventional Commits format."
  echo ""
  echo "  Expected: <type>(<scope>): <description>"
  echo "  Example:  feat(auth): add JWT refresh endpoint"
  echo ""
  echo "  Allowed types: feat, fix, chore, docs, style, refactor, test, perf, ci, build, revert"
  echo ""
  echo "  Your message: $commit_msg"
  echo ""
  exit 1
fi

exit 0
