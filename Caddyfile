:80 {
	# SSE: disable buffering so events are streamed immediately
	handle /api/sse/* {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	# API routes
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Everything else: Vite dev server (dev) or static files (prod)
	handle {
		reverse_proxy frontend:5173
	}

	# Security headers
	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
